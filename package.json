{
  "name": "cloudshort",
  "version": "0.0.0",
  "description": "A tiny URL shortener running on Cloudflare Workers with KV storage.",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.1",
    "@cloudflare/workers-types": "^5.20260730.1",
    "typescript": "^5.5.4",
    "vitest": "^4.1.11",
    "wrangler": "^4.118.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "workerd@1.20260926.1": true
  }
}
